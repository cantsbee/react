# Puerto del servidor
PORT=4000

# Cadena de conexión a MongoDB
# Local:  mongodb://127.0.0.1:27017/estudio_tatuaje
# Atlas:  mongodb+srv://usuario:clave@cluster.xxx.mongodb.net/estudio_tatuaje
MONGODB_URI=mongodb://127.0.0.1:27017/estudio_tatuaje

# Origen permitido (frontend de Vite en desarrollo)
CLIENT_URL=http://localhost:5173

# JWT — secreto para firmar tokens (cámbialo en producción)
JWT_SECRET=cambiate-este-secreto-en-produccion

# Cloudinary (subida de ficheros, opcional) — https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
